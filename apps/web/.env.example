# Keep secrets only in .env.local — never commit them.
# Next.js only auto-loads env files from this directory, not the repo root,
# so this copy (not the one at the repo root) is what `npm run dev` reads.
DATABASE_URL=postgresql://avid:avid@localhost:5432/avid
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-secret
